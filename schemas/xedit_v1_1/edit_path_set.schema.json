      },
      "type": "array"
    }
  },
  "required": [
    "path_set_id",
    "object_type",
    "paths",
    "cost_model"
  ],
  "schema_version": "1.1",
  "title": "EditPathSet (xedit_v1_1)",
  "type": "object"
}
