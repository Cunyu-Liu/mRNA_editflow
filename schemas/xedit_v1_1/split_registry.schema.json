{
  "$defs": {
    "SplitActivationDecision": {
      "additionalProperties": false,
      "properties": {
        "activation_input_manifest_sha256": {
          "type": "string"
        },
        "activation_reason": {
          "type": "string"
        },
        "decision_run_id": {
          "type": "string"
        },
        "decision_sha256": {
          "type": "string"
        },
        "split_activation_status": {
          "enum": [
            "ACTIVE",
            "CONDITIONAL_NOT_QUALIFIED"
          ],
          "type": "string"
        },
        "split_contract_id": {
          "type": "string"
        },
        "split_definition_sha256": {
          "type": "string"
        }
      },
      "required": [
        "split_contract_id",
        "decision_run_id",
        "split_definition_sha256",
        "split_activation_status",
        "activation_reason",
        "activation_input_manifest_sha256",
        "decision_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/xedit_v1_1/split_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_id": "mrna_xeditflow_goal_v1_1",
  "description": "Immutable definition registry of the 10 split contracts with activation-decision $defs.",
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "grouping_atom_projection_rule_sha256": {
      "type": "string"
    },
    "registry_version": {
      "type": "string"
    },
    "required_split_contract_ids_sha256": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "split_descriptor_set_sha256": {
      "type": "string"
    },
    "splits": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "activation_rule_id": {
            "type": "string"
          },
          "activation_rule_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignment_algorithm_id": {
            "type": "string"
          },
          "assignment_algorithm_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction_or_cohort_rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction_or_cohort_rule_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "disjointness_constraints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "grouping_atoms": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "grouping_atoms_by_object_type": {
            "type": "object"
          },
          "object_scope": {
            "enum": [
              "PAIR",
              "OBSERVATION",
              "PAIR_OR_OBSERVATION"
            ],
            "type": "string"
          },
          "partitions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "partition_id": {
                  "type": "string"
                },
                "partition_role": {
                  "enum": [
                    "TRAIN",
                    "DEVELOPMENT",
                    "INTERNAL_TEST",
                    "SEALED_FINAL",
                    "STRESS_ONLY"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "partition_id",
                "partition_role"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "region_scope": {
            "enum": [
              "5UTR",
              "3UTR",
              "CROSS_REGION",
              "MULTI_REGION"
            ],
            "type": "string"
          },
          "sealed_final": {
            "type": "boolean"
          },
          "seed_or_fold_definition": {
            "type": "string"
          },
          "split_contract_id": {
            "type": "string"
          },
          "split_version": {
            "type": "string"
          },
          "stratification_fields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "split_contract_id",
          "region_scope",
          "object_scope",
          "activation_rule_id",
          "direction_or_cohort_rule_id",
          "partitions",
          "grouping_atoms",
          "sealed_final"
        ],
        "type": "object"
      },
      "minItems": 10,
      "type": "array"
    }
  },
  "required": [
    "registry_version",
    "contract_id",
    "splits"
  ],
  "schema_version": "1.1",
  "title": "SplitRegistry (xedit_v1_1)",
  "type": "object"
}
