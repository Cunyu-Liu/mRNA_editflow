{
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/xedit_v1_1/dataset_asset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_id": "mrna_xeditflow_goal_v1_1",
  "description": "Immutable dataset asset record for the UTR Edit-Flow benchmark-first contract.",
  "properties": {
    "accession": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    },
    "critic_eligibility": {
      "enum": [
        "YES",
        "NO"
      ],
      "type": "string"
    },
    "endpoint_role": {
      "enum": [
        "DELTA",
        "ABSOLUTE_PROPERTY",
        "FAMILY_RANK",
        "RECONSTRUCTION",
        "NOT_APPLICABLE"
      ],
      "type": "string"
    },
    "flow_base_eligibility": {
      "enum": [
        "YES",
        "NO"
      ],
      "type": "string"
    },
    "guidance_training_eligibility": {
      "enum": [
        "YES",
        "NO"
      ],
      "type": "string"
    },
    "intervention_evidence_grade": {
      "description": "Evidence ladder, orthogonal to scientific_track.",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C",
        "D"
      ],
      "type": "string"
    },
    "license_status": {
      "enum": [
        "REVIEW_REQUIRED",
        "LICENSED",
        "NOT_LICENSED",
        "NOT_APPLICABLE"
      ],
      "type": "string"
    },
    "measured_optimization_eligibility": {
      "enum": [
        "YES",
        "NO"
      ],
      "type": "string"
    },
    "method_training_role": {
      "enum": [
        "EFFECT_PRIMARY",
        "FLOW_BASE",
        "CRITIC_AUX",
        "TRANSFER",
        "DIAGNOSTIC",
        "EXCLUDED"
      ],
      "type": "string"
    },
    "provider": {
      "enum": [
        "GEO",
        "SRA",
        "ENCODE",
        "BioStudies",
        "supplement",
        "author-repository",
        "other"
      ],
      "type": "string"
    },
    "publication_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "release_decision": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXCLUDED_WITH_EVIDENCE"
      ],
      "type": "string"
    },
    "retrieved_date": {
      "format": "date",
      "type": "string"
    },
    "scientific_track": {
      "description": "Retained old scientific track; A1/D never overwrite E/F.",
      "enum": [
        "E",
        "F",
        "AUX",
        "REFERENCE"
      ],
      "type": "string"
    },
    "study_id": {
      "type": "string"
    },
    "transfer_eligibility": {
      "enum": [
        "YES",
        "NO"
      ],
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "accession",
    "study_id",
    "provider",
    "publication_ids",
    "retrieved_date",
    "checksum",
    "license_status",
    "release_decision"
  ],
  "schema_version": "1.1",
  "title": "DatasetAsset (xedit_v1_1)",
  "type": "object"
}
