{
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/xedit_v1_1/reporter_artifact_assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_id": "mrna_xeditflow_goal_v1_1",
  "description": "Reporter-artifact QC assessment for a functional observation.",
  "properties": {
    "artifact_risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "type": "string"
    },
    "assessment_id": {
      "type": "string"
    },
    "assessment_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_id": {
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "observation_id": {
      "type": "string"
    },
    "risk_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_file_sha256": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "artifact_risk",
    "assessment_id",
    "evidence_id",
    "observation_id"
  ],
  "schema_version": "1.1",
  "title": "ReporterArtifactAssessment (xedit_v1_1)",
  "type": "object"
}
