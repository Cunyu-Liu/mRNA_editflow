{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/task_registry.schema.json",
  "title": "mRNA-EditFlow V2 execution task registry",
  "type": "object",
  "required": ["registry_version", "contract_id", "goal_contract_sha256", "tasks"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {"const": "2.0.0"},
    "contract_id": {"const": "utr_editflow_goal_v2"},
    "goal_contract_sha256": {
      "const": "c3dc5875868d847b8519fee40b14c43b65e4c5948dc5c3b98101ca61a5671dd5"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "phase_id",
          "status",
          "hypotheses",
          "dependencies",
          "dependency_gates",
          "scientific_service",
          "forbidden_actions",
          "inputs",
          "resource_labels",
          "conflict_keys",
          "allowed_parallel_tasks",
          "files",
          "commands",
          "outputs",
          "acceptance",
          "repair_loop",
          "commit_sha",
          "report"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{2}$"
          },
          "phase_id": {"type": "string"},
          "status": {
            "enum": [
              "PLANNED",
              "REGISTERED",
              "PREFLIGHT_PASSED",
              "RUNNING",
              "WAITING_FOR_GPU",
              "SAFE_PAUSED",
              "FAILED_WITH_EVIDENCE",
              "REPAIR_REQUIRED",
              "SUPERSEDED_WITH_TRACE",
              "VERIFIED",
              "FROZEN"
            ]
          },
          "hypotheses": {
            "type": "array",
            "items": {"type": "string", "pattern": "^H[1-8]$"},
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "dependency_gates": {
            "type": "array",
            "items": {"type": "string"}
          },
          "scientific_service": {"type": "string", "minLength": 1},
          "forbidden_actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "inputs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "resource_labels": {
            "type": "array",
            "items": {
              "enum": [
                "GPU_EXCLUSIVE",
                "CPU_LIGHT",
                "CPU_HEAVY",
                "IO_HEAVY",
                "READ_ONLY",
                "MUTATES_CODE",
                "MUTATES_DATA",
                "FINAL_LABEL_ACCESS"
              ]
            },
            "uniqueItems": true
          },
          "conflict_keys": {
            "type": "array",
            "items": {"type": "string"}
          },
          "allowed_parallel_tasks": {
            "type": "array",
            "items": {"type": "string"}
          },
          "files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "commands": {
            "type": "array",
            "items": {"type": "string"}
          },
          "outputs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "repair_loop": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "evidence_class": {
            "enum": [
              "READ_ONLY_PREFLIGHT",
              "FULL_SCOPE_DATA",
              "FULL_SCOPE_BENCHMARK",
              "SMOKE",
              "FIXTURE_ONLY"
            ]
          },
          "completion_policy": {
            "enum": ["MUST_PASS_ALL", "FAIL_CLOSED_WITH_BLOCKERS"]
          },
          "acceptance_artifact": {"type": ["string", "null"]},
          "acceptance_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "gate_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["predicate", "status", "evidence"],
              "properties": {
                "predicate": {"type": "string", "minLength": 1},
                "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          },
          "known_blockers": {
            "type": "array",
            "items": {"type": "string"}
          },
          "phase_gate": {"type": "boolean"},
          "commit_sha": {"type": ["string", "null"]},
          "report": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "phase_id": {"enum": ["D1", "B0"]}
              },
              "required": ["phase_id"]
            },
            "then": {
              "required": [
                "evidence_class",
                "completion_policy",
                "acceptance_artifact",
                "acceptance_sha256",
                "gate_evidence",
                "known_blockers",
                "phase_gate"
              ]
            }
          }
        ]
      }
    }
  }
}
