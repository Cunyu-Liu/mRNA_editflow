{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/task_registry.schema.json",
  "title": "mRNA-EditFlow execution task registry (v2)",
  "description": "Schema for docs/execution/task_registry_v2.yaml under utr_editflow_contract_v2. Phase C0 update: phase + description are now required; inputs/in_scope/out_of_scope/repair_loop/commit_sha/report are optional (early-phase tasks may not have them yet). task_id pattern allows alphanumeric suffixes (e.g., MB0-Freeze).",
  "type": "object",
  "required": ["registry_version", "contract_id", "tasks"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {"type": "string"},
    "contract_id": {"type": "string"},
    "goal_document_version": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id", "phase", "status", "dependencies", "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Z0-9]+-[A-Za-z0-9]+$"},
          "phase": {"type": "string"},
          "status": {"type": "string", "enum": ["PENDING", "IN_PROGRESS", "DONE", "BLOCKED", "FAILED"]},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "gate": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "in_scope": {"type": "array", "items": {"type": "string"}},
          "out_of_scope": {"type": "array", "items": {"type": "string"}},
          "files": {"type": "array", "items": {"type": "string"}},
          "commands": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "acceptance": {"type": "array", "items": {"type": "string"}},
          "repair_loop": {"type": "array", "items": {"type": "string"}},
          "commit_sha": {"type": ["string", "null"]},
          "report": {"type": ["string", "null"]}
        }
      }
    }
  }
}
