{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/v3_1/task_registry.schema.json",
  "title": "TaskRegistry (v3.1)",
  "description": "Immutable definition registry of the 12 required tasks with activation-calibration and activation-decision $defs.",
  "schema_version": "3.1",
  "contract_id": "utr_editflow_goal_v3.1_benchmark_first",
  "type": "object",
  "required": ["registry_version", "contract_id", "tasks"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {"type": "string"},
    "contract_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "required_task_ids_sha256": {"type": "string"},
    "task_descriptor_set_sha256": {"type": "string"},
    "activation_calibration_rule_sha256": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["task_id", "task_kind", "object_type", "scientific_track", "region_scope", "estimand_id", "activation_rule_id", "analysis_unit_id", "species_scope_policy_id"],
        "additionalProperties": false,
        "properties": {
          "task_id": {"type": "string"},
          "task_kind": {"type": "string", "enum": ["BENCHMARK_EVALUATION", "AUXILIARY_TRAINING"]},
          "object_type": {"type": "string", "enum": ["PAIR", "OBSERVATION"]},
          "scientific_track": {"type": "string", "enum": ["E", "F"]},
          "region_scope": {"type": "string", "enum": ["5UTR", "3UTR", "CROSS_REGION", "MULTI_REGION"]},
          "estimand_id": {"type": "string"},
          "activation_rule_id": {"type": "string"},
          "analysis_unit_id": {"type": "string"},
          "species_scope_policy_id": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "ActivationCalibrationMaskRow": {
      "type": "object",
      "required": ["component_id", "component_members", "calibration_partition", "mask_rule_sha256", "outcome_blind"],
      "additionalProperties": false,
      "properties": {
        "component_id": {"type": "string"},
        "component_members": {"type": "array", "items": {"type": "string"}},
        "calibration_partition": {"type": "string", "const": "DEVELOPMENT_ONLY"},
        "mask_rule_sha256": {"type": "string"},
        "outcome_blind": {"type": "boolean", "const": true}
      }
    },
    "TaskActivationDecision": {
      "type": "object",
      "required": ["task_id", "decision_run_id", "task_definition_sha256", "task_activation_status", "activation_reason", "activation_input_manifest_sha256", "activation_calibration_mask_sha256", "activation_calibration_population_sha256", "sealed_contribution_count", "internal_test_contribution_count", "selected_primary_metric_id", "confirmatory_status", "ordinary_access_event_chain_root_sha256", "decision_sha256"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "decision_run_id": {"type": "string"},
        "task_definition_sha256": {"type": "string"},
        "task_activation_status": {"type": "string", "enum": ["ACTIVE", "NOT_APPLICABLE_DATA_GATE"]},
        "activation_reason": {"type": "string"},
        "activation_input_manifest_sha256": {"type": "string"},
        "activation_calibration_mask_sha256": {"type": "string"},
        "activation_calibration_population_sha256": {"type": "string"},
        "sealed_contribution_count": {"type": "integer", "const": 0},
        "internal_test_contribution_count": {"type": "integer", "const": 0},
        "selected_primary_metric_id": {"type": "string"},
        "confirmatory_status": {"type": "string", "enum": ["CONFIRMATORY", "SECONDARY", "EXPLORATORY", "DESCRIPTIVE", "NOT_APPLICABLE_AUXILIARY", "NOT_APPLICABLE_DATA_GATE"]},
        "ordinary_access_event_chain_root_sha256": {"type": "string"},
        "decision_sha256": {"type": "string"}
      }
    }
  }
}