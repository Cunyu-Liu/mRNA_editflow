{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/v3_1/split_assignment.schema.json",
  "title": "SplitAssignment (v3.1)",
  "description": "Assignment of an object to a partition under a split contract.",
  "schema_version": "3.1",
  "contract_id": "utr_editflow_goal_v3.1_benchmark_first",
  "type": "object",
  "required": ["assignment_id", "object_id", "object_type", "split_contract_id", "partition_id", "partition_role", "assignment_algorithm_id", "assignment_algorithm_sha256"],
  "additionalProperties": false,
  "properties": {
    "assignment_id": {"type": "string"},
    "object_id": {"type": "string"},
    "object_type": {"type": "string", "enum": ["PAIR", "OBSERVATION"]},
    "split_contract_id": {"type": "string"},
    "partition_id": {"type": "string"},
    "partition_role": {"type": "string", "enum": ["TRAIN", "DEVELOPMENT", "INTERNAL_TEST", "SEALED_FINAL", "STRESS_ONLY"]},
    "assignment_algorithm_id": {"type": "string"},
    "assignment_algorithm_sha256": {"type": "string"}
  }
}