{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/v3_1/task_split_applicability.schema.json",
  "title": "TaskSplitApplicability (v3.1)",
  "description": "Definition matrix row and applicability decision for task x split.",
  "schema_version": "3.1",
  "contract_id": "utr_editflow_goal_v3.1_benchmark_first",
  "type": "object",
  "required": ["task_id", "split_contract_id", "contract_mapping", "object_type", "scientific_track", "definition_reason"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string"},
    "split_contract_id": {"type": "string"},
    "contract_mapping": {"type": "string", "enum": ["ALLOWED", "NOT_ALLOWED"]},
    "object_type": {"type": "string", "enum": ["PAIR", "OBSERVATION"]},
    "scientific_track": {"type": "string", "enum": ["E", "F"]},
    "definition_reason": {"type": "string"}
  },
  "$defs": {
    "TaskSplitDefinitionRow": {
      "type": "object",
      "required": ["task_id", "split_contract_id", "contract_mapping", "object_type", "scientific_track", "definition_reason"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "split_contract_id": {"type": "string"},
        "contract_mapping": {"type": "string", "enum": ["ALLOWED", "NOT_ALLOWED"]},
        "object_type": {"type": "string", "enum": ["PAIR", "OBSERVATION"]},
        "scientific_track": {"type": "string", "enum": ["E", "F"]},
        "definition_reason": {"type": "string"}
      }
    },
    "TaskSplitApplicabilityDecision": {
      "type": "object",
      "required": ["task_id", "split_contract_id", "effective_decision", "decision_run_id", "decision_sha256"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "split_contract_id": {"type": "string"},
        "effective_decision": {"type": "string", "enum": ["APPLICABLE", "NOT_APPLICABLE", "CONDITIONAL_NOT_QUALIFIED"]},
        "decision_run_id": {"type": "string"},
        "decision_sha256": {"type": "string"}
      }
    }
  }
}