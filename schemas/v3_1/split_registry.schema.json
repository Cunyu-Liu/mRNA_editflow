{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/v3_1/split_registry.schema.json",
  "title": "SplitRegistry (v3.1)",
  "description": "Immutable definition registry of the 10 split contracts with activation-decision $defs.",
  "schema_version": "3.1",
  "contract_id": "utr_editflow_goal_v3.1_benchmark_first",
  "type": "object",
  "required": ["registry_version", "contract_id", "splits"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {"type": "string"},
    "contract_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "required_split_contract_ids_sha256": {"type": "string"},
    "split_descriptor_set_sha256": {"type": "string"},
    "grouping_atom_projection_rule_sha256": {"type": "string"},
    "splits": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["split_contract_id", "region_scope", "object_scope", "activation_rule_id", "direction_or_cohort_rule_id", "partitions", "grouping_atoms", "sealed_final"],
        "additionalProperties": false,
        "properties": {
          "split_contract_id": {"type": "string"},
          "split_version": {"type": "string"},
          "region_scope": {"type": "string", "enum": ["5UTR", "3UTR", "CROSS_REGION", "MULTI_REGION"]},
          "object_scope": {"type": "string", "enum": ["PAIR", "OBSERVATION", "PAIR_OR_OBSERVATION"]},
          "activation_rule_id": {"type": "string"},
          "activation_rule_sha256": {"type": ["string", "null"]},
          "direction_or_cohort_rule_id": {"type": ["string", "null"]},
          "direction_or_cohort_rule_sha256": {"type": ["string", "null"]},
          "partitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["partition_id", "partition_role"],
              "additionalProperties": false,
              "properties": {
                "partition_id": {"type": "string"},
                "partition_role": {"type": "string", "enum": ["TRAIN", "DEVELOPMENT", "INTERNAL_TEST", "SEALED_FINAL", "STRESS_ONLY"]}
              }
            }
          },
          "grouping_atoms": {"type": "array", "items": {"type": "string"}},
          "grouping_atoms_by_object_type": {"type": "object"},
          "disjointness_constraints": {"type": "array", "items": {"type": "string"}},
          "stratification_fields": {"type": "array", "items": {"type": "string"}},
          "assignment_algorithm_id": {"type": "string"},
          "assignment_algorithm_sha256": {"type": ["string", "null"]},
          "seed_or_fold_definition": {"type": "string"},
          "sealed_final": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "SplitActivationDecision": {
      "type": "object",
      "required": ["split_contract_id", "decision_run_id", "split_definition_sha256", "split_activation_status", "activation_reason", "activation_input_manifest_sha256", "decision_sha256"],
      "additionalProperties": false,
      "properties": {
        "split_contract_id": {"type": "string"},
        "decision_run_id": {"type": "string"},
        "split_definition_sha256": {"type": "string"},
        "split_activation_status": {"type": "string", "enum": ["ACTIVE", "CONDITIONAL_NOT_QUALIFIED"]},
        "activation_reason": {"type": "string"},
        "activation_input_manifest_sha256": {"type": "string"},
        "decision_sha256": {"type": "string"}
      }
    }
  }
}