{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/v3_1/generation_task.schema.json",
  "title": "GenerationTask (v3.1)",
  "description": "Open-generation diagnostic task and its DiagnosticRegistryRow $defs.",
  "schema_version": "3.1",
  "contract_id": "utr_editflow_goal_v3.1_benchmark_first",
  "type": "object",
  "required": ["generation_task_id", "object_type", "unique_source_id", "denominator_rule", "claim_policy"],
  "additionalProperties": false,
  "properties": {
    "generation_task_id": {"type": "string"},
    "object_type": {"type": "string", "enum": ["GENERATION_TASK"]},
    "unique_source_id": {"type": "string"},
    "denominator_rule": {"type": "string"},
    "claim_policy": {"type": "string"},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "DiagnosticRegistryRow": {
      "type": "object",
      "required": ["diagnostic_id", "object_type", "unit_id", "schema_ref", "denominator_rule", "claim_policy"],
      "additionalProperties": false,
      "properties": {
        "diagnostic_id": {"type": "string"},
        "object_type": {"type": "string", "enum": ["GENERATION_TASK"]},
        "unit_id": {"type": "string"},
        "schema_ref": {"type": "string"},
        "denominator_rule": {"type": "string"},
        "claim_policy": {"type": "string"},
        "reports_section": {"type": "string"}
      }
    }
  }
}