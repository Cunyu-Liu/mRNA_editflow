    "source_sequence_id": {"type": "string"},
    "candidate_sequence_id": {"type": "string"},
    "pairing_method": {"type": "string"},
    "evidence_id": {"type": "string"},
    "lifecycle_status": {"type": "string", "enum": ["CANDIDATE", "ACCEPTED", "REJECTED"]}
