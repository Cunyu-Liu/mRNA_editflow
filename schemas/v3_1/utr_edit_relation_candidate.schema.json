{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/mRNA_editflow/schemas/v3_1/utr_edit_relation_candidate.schema.json",
  "title": "UTR-Edit-Relation Candidate (v3.1)",
  "description": "Candidate for a source/candidate UTR edit relation (Track E).",
  "schema_version": "3.1",
