        "max_state_dp_cells_per_record",
        "max_spill_bytes_per_record",
        "chunk_size",
        "max_open_chunks",
        "heartbeat_seconds"
      ],
      "properties": {
        "minimum_free_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_rss_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_spill_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_dag_cells_per_record": {
          "type": "integer",
          "minimum": 1
        },
        "max_reachable_states_per_record": {
          "type": "integer",
          "minimum": 50001
        },
        "max_neighbor_expansions_per_record": {
          "type": "integer",
          "minimum": 1
        },
        "max_state_dp_cells_per_record": {
          "type": "integer",
          "minimum": 1
        },
        "max_spill_bytes_per_record": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_open_chunks": {
          "type": "integer",
          "minimum": 2
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 300
        }
      }
    },
    "algorithmContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_state_algorithm",
        "state_closure_scope",
        "state_path_count_scope",
        "primitive_action_evaluation_scope",
        "near_neighbor_algorithm",
        "near_neighbor_edit_distance_threshold",
        "frozen_b0_limits",
        "diagnostic_safety_limits"
      ],
      "properties": {
        "path_state_algorithm": {
          "const": "all_shortest_dynamic_edit_state_closure_v3"
        },
        "state_closure_scope": {
          "const": "all_shortest_primitive_dynamic_edit_execution_orders_sequence_identity"
        },
        "state_path_count_scope": {
          "const": "minimum_primitive_edit_state_paths_coordinate_equivalent_transitions_collapsed"
        },
        "primitive_action_evaluation_scope": {
          "const": "distinct_dynamic_geodesic_actions_before_sequence_identity_collapse"
        },
        "near_neighbor_algorithm": {
          "const": "six_block_pigeonhole_all_substring_candidates_exact_banded_levenshtein_v1"
        },
        "near_neighbor_edit_distance_threshold": {
          "const": 5
        },
        "frozen_b0_limits": {
          "$ref": "#/$defs/frozenB0Limits"
        },
        "diagnostic_safety_limits": {
          "$ref": "#/$defs/diagnosticSafetyLimits"
        }
      }
