    "resultSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_capacity_complete",
        "lower_bounds_present",
        "no_approximation_emitted",
        "usable_for_budget_decision",
        "usable_for_b0_acceptance"
      ],
      "properties": {
        "exact_capacity_complete": {
          "type": "boolean"
        },
        "lower_bounds_present": {
          "type": "boolean"
        },
        "no_approximation_emitted": {
          "const": true
        },
        "usable_for_budget_decision": {
          "type": "boolean"
        },
        "usable_for_b0_acceptance": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lower_bounds_present": {
                "const": true
              }
            },
            "required": [
              "lower_bounds_present"
            ]
          },
          "then": {
            "properties": {
              "exact_capacity_complete": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "completionSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
