      "properties": {
        "scheduled_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "exact_completed_count": {
          "type": "integer",
          "minimum": 0
        },
        "lower_bound_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "outcome_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "EXACT_COMPLETED",
            "LOWER_BOUND_STOPPED"
