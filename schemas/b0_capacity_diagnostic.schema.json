            "INPUT_FAILURE",
            "UNHANDLED_FAILURE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/artifactRef"
        },
        "partial_outputs_preserved": {
          "const": true
        },
        "resume_allowed": {
          "type": "boolean"
        }
      }
    }
  }
