        },
        "max_reachable_states": {
          "const": 50000
        },
        "max_neighbor_expansions": {
          "const": 5000000
        },
        "max_state_dp_cells": {
          "const": 50000000
        },
        "max_sequences": {
          "const": 100000
        },
        "max_block_postings": {
          "const": 600000
        },
        "max_substring_probes": {
          "const": 50000000
        },
        "max_candidate_pairs": {
          "const": 1000000
        },
        "max_exact_dp_cells": {
          "const": 100000000
        }
      }
    },
    "diagnosticSafetyLimits": {
