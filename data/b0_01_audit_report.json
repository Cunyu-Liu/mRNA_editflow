  "findings": [
    {
      "id": "B0-01-F1",
      "severity": "info",
      "message": "D1 paired records (11885 from GSE114002+GSE200304) did not emit metadata.record_type; B0-01 schema infers it from source_sequence presence (paired if not None). Inferred value is written back to metadata on from_dict so downstream consumers see explicit record_type."
    },
    {
      "id": "B0-01-F2",
      "severity": "info",
      "message": "GSE173083 record uses region='full_length' (underscore) while v2 contract uses 'full-length' (hyphen). Schema normalizes the alias on ingestion."
    },
    {
      "id": "B0-01-F3",
      "severity": "warning",
      "message": "4 D_C datasets (ENCSR854RUF, GSE246381, GSE217518, GSE149487) have only INCOMPLETE placeholder records in d1_canonical_records.jsonl because D1 build_canonical_records.py could not extract UTR sequences from their downloaded files (missing sequence columns / barcode mappings). Only 2 D_C datasets (GSE114002: 5000, GSE200304: 6885) have actual paired records. This may constrain B0-02 split manifests and B0-04 evaluation tracks. The D1 audit report marked these as 'found' (>=1 record) but did not flag the missing paired data. Recommend: address before B0-02 if closed_measured_pool track needs >2 D_C datasets."
    }
  ],
