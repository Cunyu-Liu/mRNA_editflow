  "schemas": {
    "utr_edit_record": {
      "dataclass": "UTREditRecord",
      "module": "d1_staging/scripts/b0/canonical_schemas.py",
      "fields": [
        "record_id", "dataset", "accession", "region",
        "source_sequence", "candidate_sequence", "edit_script",
        "labels", "metadata"
      ],
      "record_types": ["paired", "observational", "incomplete"],
      "regions": ["5'UTR", "3'UTR", "CDS", "full-length"],
      "frozen": true,
      "round_trip_with_d1_flat_form": true,
      "backward_compat": "infers record_type when missing (legacy D1 paired records); normalizes 'full_length' -> 'full-length'"
    },
    "edit_script": {
      "dataclass": "EditScript",
      "module": "d1_staging/scripts/b0/canonical_schemas.py",
      "fields": [
        "ops", "verified", "edit_distance",
        "n_ins", "n_del", "n_sub", "path_ambiguity"
      ],
      "op_types": ["INS", "DEL", "SUB", "STOP"],
      "stop_policy": "STOP reserved for generation; rejected in canonical edit scripts",
      "frozen": true,
      "invariants_enforced": [
        "no STOP in canonical edit scripts",
        "n_ins/n_del/n_sub counts match ops",
        "edit_distance == n_ins + n_del + n_sub",
        "path_ambiguity >= 1"
      ]
    },
    "generation_task": {
      "dataclass": "GenerationTask",
      "module": "d1_staging/scripts/b0/canonical_schemas.py",
      "fields": [
        "task_id", "record_id", "track", "region", "edit_budget",
        "target_endpoint", "target_direction", "target_quantile",
        "max_length", "min_length", "must_preserve_motifs",
        "allowed_claims", "forbidden_claims", "notes"
      ],
      "tracks": [
        "closed_measured_pool",
        "heldout_generative",
        "open_legal_generation"
      ],
      "edit_budget_values": [0, 1, 3, 5],
      "region_restriction": "only 5'UTR and 3'UTR (CDS/full-length not editable)",
      "frozen": true
    }
  },
